# ---------------------------------------------------------------------------
# Docker Compose deployment (the workflow overrides the image with its digest)
# Keep the bind address on loopback; the host reverse proxy owns public ports.
# ---------------------------------------------------------------------------
SEDEKAHJE_IMAGE="ghcr.io/khrnchn/sedekah-je:latest"
SEDEKAHJE_BIND_ADDRESS="127.0.0.1"
SEDEKAHJE_PORT="3001"
SEDEKAHJE_CPU_LIMIT="1.0"
SEDEKAHJE_MEMORY_LIMIT="1536m"

# ---------------------------------------------------------------------------
# Database (required)
# Supabase remains the database; EC2 only hosts the web application.
# For this persistent container, prefer Supabase's direct connection when EC2
# can reach it over IPv6 (or the project has the IPv4 add-on). On IPv4-only EC2,
# use the Supavisor session pooler on port 5432. Port 6543 transaction mode is
# intended for short-lived serverless/edge clients.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres.project-ref:pass@aws-region.pooler.supabase.com:5432/postgres?sslmode=require"
# Direct (non-pooled) connection, used by drizzle-kit migrations only.
# This is a developer/maintenance value and is not read by the EC2 deployment.
DIRECT_URL="postgresql://postgres:pass@db.project-ref.supabase.co:5432/postgres?sslmode=require"

# ---------------------------------------------------------------------------
# Cloudflare R2 object storage (required — the app will not boot without these)
# ---------------------------------------------------------------------------
R2_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID="your-access-key-id"
R2_SECRET_ACCESS_KEY="your-secret-access-key"
R2_BUCKET_NAME="your-bucket-name"
R2_PUBLIC_URL="https://your-public-bucket-domain"

# ---------------------------------------------------------------------------
# Better Auth (required for sign-in)
# BETTER_AUTH_URL must match the public origin exactly, scheme included.
# ---------------------------------------------------------------------------
BETTER_AUTH_SECRET="generate-a-long-random-string"
BETTER_AUTH_URL="https://sedekah.je"
NEXT_PUBLIC_APP_URL="https://sedekah.je"
GOOGLE_CLIENT_ID="your-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

# ---------------------------------------------------------------------------
# Turnstile bot protection (required for the contribute form)
# ---------------------------------------------------------------------------
CLOUDFLARE_TURNSTILE_SECRET_KEY="your-turnstile-secret"
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY="your-turnstile-site-key"

# ---------------------------------------------------------------------------
# Google Maps (build-time; baked into the client bundle)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-browser-api-key"
# Server-side geocoding, used by backfill scripts only.
GOOGLE_GEOCODING_API_KEY="your-server-api-key"

# ---------------------------------------------------------------------------
# Telegram review bot (optional; the admin review flow degrades without it)
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN="your-bot-token"
TELEGRAM_CHAT_ID="your-private-chat-id"
TELEGRAM_WEBHOOK_SECRET="generate-a-random-webhook-secret"
TELEGRAM_REVIEWER_USER_ID="your-sedekah-je-admin-user-id"
TELEGRAM_ADMIN_BASE_URL="https://sedekah.je"

# ---------------------------------------------------------------------------
# MailerSend approval emails (optional)
# ---------------------------------------------------------------------------
MAILERSEND_API_KEY="your-mailersend-key"
MAILERSEND_FROM_EMAIL="noreply@sedekah.je"
MAILERSEND_FROM_NAME="Sedekah Je"
MAILERSEND_APPROVAL_TEMPLATE_ID="your-template-id"

# ---------------------------------------------------------------------------
# Threads / Meta integration (optional)
# META_CALLBACK_BASE must match the public origin.
# ---------------------------------------------------------------------------
META_CALLBACK_BASE="https://sedekah.je"
THREADS_API_CLIENT_ID="your-threads-client-id"
THREADS_API_CLIENT_SECRET="your-threads-client-secret"
THREADS_APP_SECRET="your-threads-app-secret"
THREADS_USER_ID="your-threads-user-id"
THREADS_ACCESS_TOKEN="your-long-lived-threads-token"
THREADS_EXPIRES_IN=""

# ---------------------------------------------------------------------------
# Scripts and analytics (optional; not needed to serve traffic)
# ---------------------------------------------------------------------------
OPENAI_API_KEY="your-openai-key"
BULK_IMPORT_CONTRIBUTOR_ID="better-auth-user-id"
UMAMI_DATABASE_URL=""

# Supabase JS client (optional; unused by the current runtime paths)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
